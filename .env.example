# Copier en .env à côté de docker-compose.yml sur jobtrack-server.
#
# ATTENTION — ne concerne PAS VITE_API_URL / VITE_MESSAGING_API_URL : ces deux
# variables sont bakées dans le bundle JS au moment du build Docker (Vite),
# pas lues au démarrage du conteneur. Elles se configurent comme variables
# GitLab CI/CD (Settings > CI/CD > Variables) sur ce repo, pas ici :
#   VITE_API_URL              -> ex. http://<IP_EC2>:3000
#   VITE_MESSAGING_API_URL    -> ex. http://<IP_EC2>:3100
#
# Seule variable réellement lue par docker-compose.yml au runtime :

# Port hôte exposé (mapping vers le 80 du conteneur nginx)
FRONTEND_PORT=80
